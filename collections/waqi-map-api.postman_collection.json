      "item": [
        {
          "id": "bc5ec0d4-e785-4d91-a0cc-d3041fe1698f",
          "name": "Get monitoring stations within geographic bounds",
          "request": {
            "name": "Get monitoring stations within geographic bounds",
            "description": {
              "content": "Returns all monitoring stations within a specified rectangular geographic bounding box, suitable for map display. Supports filtering by network (network parameter).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "map",
                "bounds",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "latlng",
                  "value": "<string>",
                  "description": "(Required) Bounding box as a comma-separated string in the format: lat_north,lng_west,lat_south,lng_east."
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "(Required) API authentication token."
                },
                {
                  "disabled": false,
                  "key": "networks",
                  "value": "<string>",
                  "description": "Filter results by monitoring network (e.g., 'all' for all networks)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
