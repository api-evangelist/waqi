        {
          "id": "da5e953b-4ac8-432f-a93a-1d2e30064d24",
          "name": "Get air quality feed for a city",
          "request": {
            "name": "Get air quality feed for a city",
            "description": {
              "content": "Returns the current air quality data for a specified city or monitoring station. Provides AQI readings, pollutant measurements (PM2.5, PM10, NO2, CO, SO2, Ozone), station coordinates, weather conditions, and forecast data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "feed",
                ":city",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "(Required) API authentication token obtained from the Air Quality Open Data Platform."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "city",
                  "description": "(Required) City name or station identifier (e.g., 'shanghai', 'beijing', '@8397' for station ID). Use 'here' for IP-based geolocation."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
