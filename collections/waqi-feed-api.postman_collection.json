  "info": {
    "_postman_id": "447c31f6-d254-4df1-abee-a5f2895295e2",
    "name": "World Air Quality Index (WAQI) JSON Feed API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The WAQI JSON API provides real-time air quality data, AQI readings, pollutant measurements, and station data for more than 12,000 monitoring stations worldwide. It delivers city-level and station-level air quality index values for pollutants including PM2.5, PM10, NO2, CO, SO2, and Ozone, along with geo-location queries, weather conditions, and 3-8 day forecast data. Authentication requires a free token obtained from the Air Quality Open Data Platform.\n\nContact Support:\n Name: WAQI Support",
      "type": "text/plain"
    }
  }
